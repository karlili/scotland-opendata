{
  "name": "scotland-opendata",
  "version": "0.1.0",
  "private": true,
  "description": "A hub that proxies Scottish public sector open data and republishes it as a REST API and an MCP server.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "sync": "tsx src/cli/sync.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.2",
    "@hono/node-server": "^2.1.5",
    "@hono/standard-validator": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@scalar/hono-api-reference": "^0.12.12",
    "@standard-community/standard-json": "^0.3.6",
    "@standard-community/standard-openapi": "^0.2.10",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "hono-openapi": "^1.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.28.0"
}
